{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wowdecomp Universal Modding Framework API",
  "version": "1.1.0",
  "engine": "wowdecomp",
  "modules": {
    "ModCore": {
      "description": "Master modding framework runtime controller",
      "parent": "",
      "methods": [
        {
          "name": "LogDebug",
          "description": "Logs a debug message to client console",
          "returnType": "void",
          "params": [
            { "name": "fmt", "type": "string", "description": "Format string" },
            { "name": "...", "type": "any", "description": "Arguments" }
          ]
        },
        {
          "name": "LogInfo",
          "description": "Logs an info message to client console",
          "returnType": "void",
          "params": [
            { "name": "fmt", "type": "string", "description": "Format string" },
            { "name": "...", "type": "any", "description": "Arguments" }
          ]
        },
        {
          "name": "LogWarn",
          "description": "Logs a warning message to client console",
          "returnType": "void",
          "params": [
            { "name": "fmt", "type": "string", "description": "Format string" },
            { "name": "...", "type": "any", "description": "Arguments" }
          ]
        },
        {
          "name": "LogError",
          "description": "Logs an error message to client console",
          "returnType": "void",
          "params": [
            { "name": "fmt", "type": "string", "description": "Format string" },
            { "name": "...", "type": "any", "description": "Arguments" }
          ]
        },
        {
          "name": "MountMod",
          "description": "Mounts and initializes an external mod package",
          "returnType": "boolean",
          "params": [
            { "name": "modDir", "type": "string", "description": "Path" },
            { "name": "manifest", "type": "table", "description": "Manifest" }
          ]
        },
        {
          "name": "RegisterHook",
          "description": "Registers a callback listener for an engine or gameplay hook",
          "returnType": "void",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "callback", "type": "fun(...): any?", "description": "Listener" },
            { "name": "priority?", "type": "integer", "description": "Priority (default 100)" },
            { "name": "doc?", "type": "string", "description": "Documentation" }
          ]
        },
        {
          "name": "UnregisterHook",
          "description": "Unregisters a callback from a hook",
          "returnType": "void",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "callback", "type": "fun(...)", "description": "Listener" }
          ]
        },
        {
          "name": "FireHook",
          "description": "Fires a hook across all listeners and returns early override if non-nil",
          "returnType": "any?",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "...", "type": "any", "description": "Parameters" }
          ]
        },
        {
          "name": "On",
          "description": "Event emitter syntax alias for RegisterHook",
          "returnType": "void",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "callback", "type": "fun(...): any?", "description": "Listener" },
            { "name": "priority?", "type": "integer", "description": "Priority" },
            { "name": "doc?", "type": "string", "description": "Documentation" }
          ]
        },
        {
          "name": "DispatchHook",
          "description": "Direct hook dispatcher invoked by C++ engine",
          "returnType": "any?",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "...", "type": "any", "description": "Parameters" }
          ]
        },
        {
          "name": "GetHookList",
          "description": "Returns array of all registered hook names and metadata",
          "returnType": "table",
          "params": [
          ]
        },
        {
          "name": "GetApiSchema",
          "description": "Returns complete machine schema for frontend extension",
          "returnType": "table",
          "params": [
          ]
        },
        {
          "name": "ExportApi",
          "description": "Triggers immediate autogeneration of all API definitions and schemas",
          "returnType": "boolean",
          "params": [
          ]
        }
      ]
    },
    "Hooks": {
      "description": "Event and lifecycle dispatch bus",
      "parent": "",
      "methods": [
        {
          "name": "Register",
          "description": "Registers a callback for an event",
          "returnType": "void",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "callback", "type": "fun(...)", "description": "Function" },
            { "name": "priority?", "type": "integer", "description": "Priority" },
            { "name": "doc?", "type": "string", "description": "Doc" }
          ]
        },
        {
          "name": "Unregister",
          "description": "Unregisters a callback",
          "returnType": "void",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "callback", "type": "fun(...)", "description": "Function" }
          ]
        },
        {
          "name": "Fire",
          "description": "Fires hook across listeners",
          "returnType": "any?",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" },
            { "name": "...", "type": "any", "description": "Args" }
          ]
        },
        {
          "name": "HasListeners",
          "description": "Returns true if any callbacks are registered for hook",
          "returnType": "boolean",
          "params": [
            { "name": "hookName", "type": "string", "description": "Hook name" }
          ]
        },
        {
          "name": "GetMetadata",
          "description": "Returns dictionary of hook docstrings",
          "returnType": "table<string, string>",
          "params": [
          ]
        },
        {
          "name": "GetHookList",
          "description": "Returns list of all active hook names",
          "returnType": "table<integer, string>",
          "params": [
          ]
        }
      ]
    },
    "Net": {
      "description": "Declarative packet serialization and opcode router",
      "parent": "",
      "methods": [
        {
          "name": "DefinePacket",
          "description": "Defines a typed binary packet schema",
          "returnType": "void",
          "params": [
            { "name": "name", "type": "string", "description": "Packet identifier" },
            { "name": "definition", "type": "table", "description": "Opcode and schema" }
          ]
        },
        {
          "name": "Send",
          "description": "Constructs and transmits a binary packet to server",
          "returnType": "boolean",
          "params": [
            { "name": "name", "type": "string", "description": "Packet identifier" },
            { "name": "data", "type": "table", "description": "Payload" }
          ]
        },
        {
          "name": "OnCustomPacket",
          "description": "Registers a callback for a specific network opcode",
          "returnType": "void",
          "params": [
            { "name": "opcode", "type": "integer", "description": "Network opcode" },
            { "name": "handler", "type": "fun(reader: any)", "description": "Handler" }
          ]
        }
      ]
    },
    "DbcEngine": {
      "description": "Virtual DBC table and row injector",
      "parent": "",
      "methods": [
        {
          "name": "GetTable",
          "description": "Retrieves a table handle for a loaded DBC",
          "returnType": "table",
          "params": [
            { "name": "tableName", "type": "string", "description": "DBC name" }
          ]
        },
        {
          "name": "RegisterVirtualRow",
          "description": "Injects an in-memory virtual record into DBC",
          "returnType": "void",
          "params": [
            { "name": "tableName", "type": "string", "description": "DBC name" },
            { "name": "id", "type": "integer", "description": "Record ID" },
            { "name": "data", "type": "table", "description": "Record fields" }
          ]
        },
        {
          "name": "OverrideRow",
          "description": "Overrides specific fields in an existing DBC record",
          "returnType": "void",
          "params": [
            { "name": "tableName", "type": "string", "description": "DBC name" },
            { "name": "id", "type": "integer", "description": "Record ID" },
            { "name": "overrides", "type": "table", "description": "Field overrides" }
          ]
        },
        {
          "name": "OnRowLookup",
          "description": "Intercepts runtime DBC row queries",
          "returnType": "void",
          "params": [
            { "name": "tableName", "type": "string", "description": "DBC name" },
            { "name": "callback", "type": "fun(id: integer): table?", "description": "Handler" }
          ]
        }
      ]
    },
    "Visuals": {
      "description": "Combat decals, telegraphs, and ribbon trail manager",
      "parent": "",
      "methods": [
        {
          "name": "CreateDecal",
          "description": "Emits a ground decal (circle, donut, cone, rect)",
          "returnType": "table",
          "params": [
            { "name": "params", "type": "table", "description": "Decal parameters" }
          ]
        },
        {
          "name": "CreateRibbonTrail",
          "description": "Attaches a weapon ribbon trail to player/unit model",
          "returnType": "table",
          "params": [
            { "name": "params", "type": "table", "description": "Trail parameters" }
          ]
        }
      ]
    },
    "C3Vector": {
      "description": "3D coordinate vector in World space",
      "parent": "",
      "methods": [
      ]
    },
    "Quat": {
      "description": "4D quaternion for 3D rotation",
      "parent": "",
      "methods": [
      ]
    },
    "WOWGUID": {
      "description": "64-bit entity identifier in World of Warcraft",
      "parent": "",
      "methods": [
        {
          "name": "IsValid",
          "description": "Returns true if GUID is non-zero",
          "returnType": "boolean",
          "params": [
          ]
        }
      ]
    },
    "CGObject_C": {
      "description": "Base entity in client object manager",
      "parent": "",
      "methods": [
        {
          "name": "GetGUID",
          "description": "Returns entity GUID",
          "returnType": "WOWGUID",
          "params": [
          ]
        },
        {
          "name": "GetPosition",
          "description": "Returns 3D world position",
          "returnType": "C3Vector",
          "params": [
          ]
        },
        {
          "name": "IsValid",
          "description": "Returns true if entity pointer is valid",
          "returnType": "boolean",
          "params": [
          ]
        }
      ]
    },
    "CGUnit_C": {
      "description": "Unit entity (player, NPC, pet)",
      "parent": "CGObject_C",
      "methods": [
        {
          "name": "GetHealth",
          "description": "Returns current health",
          "returnType": "integer",
          "params": [
          ]
        },
        {
          "name": "GetMaxHealth",
          "description": "Returns maximum health",
          "returnType": "integer",
          "params": [
          ]
        },
        {
          "name": "GetPower",
          "description": "Returns current power for type",
          "returnType": "integer",
          "params": [
            { "name": "powerType", "type": "integer", "description": "Power type" }
          ]
        },
        {
          "name": "GetMaxPower",
          "description": "Returns maximum power for type",
          "returnType": "integer",
          "params": [
            { "name": "powerType", "type": "integer", "description": "Power type" }
          ]
        },
        {
          "name": "IsPlayer",
          "description": "Returns true if unit is player character",
          "returnType": "boolean",
          "params": [
          ]
        },
        {
          "name": "IsFriendly",
          "description": "Returns true if unit is friendly to active player",
          "returnType": "boolean",
          "params": [
          ]
        },
        {
          "name": "GetUnitName",
          "description": "Returns unit name string",
          "returnType": "string",
          "params": [
          ]
        }
      ]
    },
    "CGPlayer_C": {
      "description": "Player character entity",
