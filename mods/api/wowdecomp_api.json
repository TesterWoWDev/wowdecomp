      "returnDoc": "",
      "params": [
      ]
    },
    "OnMapChange": {
      "category": "World",
      "description": "Fired when CWorld loads or changes the active map",
      "returnType": "void",
      "returnDoc": "",
      "params": [
        { "name": "mapName", "type": "string", "description": "Internal map directory name" },
        { "name": "zoneId", "type": "integer", "description": "Zone identifier" }
      ]
    },
    "OnWorldUpdate": {
      "category": "World",
      "description": "Fired every game tick during world update loop (ideal for visual updates and animation)",
      "returnType": "void",
      "returnDoc": "",
      "params": [
        { "name": "dt", "type": "number", "description": "Delta time in seconds" }
      ]
    },
