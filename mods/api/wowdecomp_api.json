      "returnDoc": "Return true to block transmission",
      "params": [
        { "name": "opcode", "type": "integer", "description": "Network opcode" },
        { "name": "size", "type": "integer", "description": "Byte length" },
        { "name": "dataStore", "type": "any", "description": "Data buffer" }
      ]
    },
    "OnDisconnect": {
      "category": "Network",
