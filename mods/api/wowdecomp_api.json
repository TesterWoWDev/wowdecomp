        { "name": "guid", "type": "number", "description": "64-bit GUID of hit entity" },
        { "name": "point", "type": "any", "description": "3D hit coordinate" },
        { "name": "hitObject", "type": "boolean", "description": "True if entity hit" }
      ]
    },
    "OnTerrainTrack": {
      "category": "World",
      "description": "Fired during mouse terrain tracking queries",
      "returnType": "boolean?",
      "returnDoc": "Return true to consume tracking",
      "params": [
        { "name": "point", "type": "any", "description": "3D terrain coordinate" }
      ]
