      "params": [
        { "name": "button", "type": "integer", "description": "Mouse button index" },
        { "name": "x", "type": "number", "description": "World X" },
        { "name": "y", "type": "number", "description": "World Y" },
        { "name": "z", "type": "number", "description": "World Z" }
      ]
    },
    "OnGlueResume": {
