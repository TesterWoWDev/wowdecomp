        { "name": "opcode", "type": "integer", "description": "Network opcode" },
        { "name": "time", "type": "integer", "description": "Server packet timestamp" },
        { "name": "reader", "type": "any", "description": "Packet reader buffer" }
      ]
    },
    "OnPacketSend": {
      "category": "Network",
      "description": "Fired before a packet is transmitted to the server",
