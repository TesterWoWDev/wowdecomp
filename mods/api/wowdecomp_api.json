      "methods": [
        {
          "name": "GetTargetGuid",
          "description": "Returns GUID of currently targeted entity",
          "returnType": "WOWGUID",
          "params": [
          ]
        }
      ]
    },
    "ClntObjMgr": {
      "description": "Client Object Manager query interface",
      "parent": "",
      "methods": [
        {
          "name": "GetActivePlayer",
          "description": "Returns the active player character entity",
          "returnType": "CGPlayer_C",
          "params": [
          ]
        },
        {
          "name": "GetObject",
          "description": "Queries an entity by its GUID",
          "returnType": "CGObject_C?",
          "params": [
            { "name": "guid", "type": "WOWGUID", "description": "Entity GUID" }
          ]
        }
      ]
    }
  },
  "hooks": {
    "OnEngineInit": {
      "category": "Lifecycle",
      "description": "Fired when the client engine completes low-level initialization",
      "returnType": "void",
      "returnDoc": "",
      "params": [
      ]
    },
    "OnEngineShutdown": {
      "category": "Lifecycle",
      "description": "Fired when the client engine begins shutdown sequence",
      "returnType": "void",
      "returnDoc": "",
      "params": [
      ]
    },
    "OnGameInitialize": {
      "category": "Lifecycle",
      "description": "Fired when CGGameUI initializes the active gameplay world session",
      "returnType": "void",
      "returnDoc": "",
      "params": [
      ]
    },
    "OnGameDestroy": {
      "category": "Lifecycle",
